# Copy this file on the VPS to /opt/pino-production-system/.env.production.
# Do not commit the populated file.
NODE_ENV=production
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
NEXTAUTH_SECRET="replace-with-a-long-random-value"
AUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://YOUR_SERVER_IP"
AUTH_URL="http://YOUR_SERVER_IP"
SESSION_MAX_AGE=28800
NEXT_PUBLIC_APP_NAME="Pino Production System"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="..."
SUPABASE_SECRET_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."
